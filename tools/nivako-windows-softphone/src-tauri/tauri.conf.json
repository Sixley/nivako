{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NIVAKO Softphone",
  "version": "0.9.6",
  "identifier": "de.nivako.softphone",
  "build": {
    "beforeDevCommand": "npm run dev:vite -- --port 5178",
    "devUrl": "http://localhost:5178",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node src-tauri/scripts/stage-linphone-runtime.cjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NIVAKO Softphone",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost wss://pbx.nivako.de:8089; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": ["nsis"],
    "publisher": "NIVAKO",
    "category": "Business",
    "resources": {
      "linphone-runtime/*.dll": "",
      "linphone-runtime/lib/": "lib/",
      "linphone-runtime/share/": "share/"
    }
  }
}
