{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NIVAKO Softphone",
  "version": "0.1.0",
  "identifier": "de.nivako.softphone",
  "build": {
    "beforeDevCommand": "npm run dev:vite -- --port 5178",
    "devUrl": "http://localhost:5178",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node src-tauri/scripts/stage-linphone-runtime.cjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NIVAKO Softphone",
        "width": 1280,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": ["msi", "nsis"],
    "publisher": "NIVAKO",
    "category": "Business",
    "resources": {
      "linphone-runtime/*.dll": ""
    }
  }
}
